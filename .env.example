# Database
POSTGRES_DB=logiflow
POSTGRES_USER=logiflow
POSTGRES_PASSWORD=logiflow-local-password
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=local-development-jwt-secret-change-before-deployment
JWT_EXPIRATION_MS=36000000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8085

# Mistral AI
MISTRAL_AI_API_KEY=your_mistral_api_key_here

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (Resend / SMTP)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=your_resend_api_key_here
MAIL_FROM=onboarding@resend.dev

# PayPal (Optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:8080/api/payment/return
PAYPAL_CANCEL_URL=http://localhost:8080/api/payment/cancel

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# Mobile
MOBILE_PORT=8085
